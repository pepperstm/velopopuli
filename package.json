{
  "name": "velopopuli",
  "version": "0.3.0",
  "description": "Open-source indoor cycling: ride any GPX route on your smart trainer in a 3D virtual world.",
  "license": "GPL-3.0-or-later",
  "author": "VeloPopuli contributors",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "cargo test -p velopopuli-core",
    "tauri": "tauri",
    "build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "format": "cargo fmt --all && prettier --write \"web/src/**/*.{ts,tsx,css}\"",
    "check": "cargo fmt --all --check && prettier --check \"web/src/**/*.{ts,tsx,css}\" && tsc --noEmit && cargo clippy --workspace -- -D clippy::correctness && cargo test --workspace"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "leaflet": "^1.9.4",
    "prettier": "^3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3"
  }
}
